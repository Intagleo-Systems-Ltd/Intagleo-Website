# =============================================================================
# Intagleo — environment variables (KEYS ONLY — copy real values from Vercel).
# This is a migration checklist; it is committed. NEVER put real secrets here.
# Real values live in: Vercel env manager, or a chmod-600 .env.local /
# .env.production on the server (both gitignored).
#
#   🏗️ = needed at BUILD time (inlined into the bundle by `next build`)
#   🔒 = needed at RUNTIME (read by the Node process)
# =============================================================================

# ── Sanity CMS ──
NEXT_PUBLIC_SANITY_PROJECT_ID=          # 🏗️
NEXT_PUBLIC_SANITY_DATASET=             # 🏗️
SANITY_API_TOKEN=                       # 🔒 data fetching
SANITY_REVALIDATE_SECRET=               # 🔒 revalidate webhook
CONTENT_PROVIDER=                       # 🔒 "files" or "sanity"

# ── Admin auth ──
JWT_SECRET=                             # 🔒

# ── Email (SMTP) — contact + careers forms ──
SMTP_HOST=                              # 🔒
SMTP_PORT=                              # 🔒 e.g. 465
SMTP_SECURE=                            # 🔒 "true" for port 465
SMTP_USER=                             # 🔒
SMTP_PASS=                              # 🔒
SMTP_FROM=                             # 🔒

# ── Lead routing (comma-separated emails) ──
CONTACT_NOTIFY_EMAILS=                  # 🔒 general contact
CONTACT_US_SLED_EMAILS=                 # 🔒 US-SLED briefing requests
CAREERS_NOTIFY_EMAILS=                  # 🔒 careers/apply form
# Optional per-type overrides (fall back to CONTACT_NOTIFY_EMAILS if unset):
# CONTACT_START_PROJECT_EMAILS=
# CONTACT_AI_STRATEGY_EMAILS=
# CONTACT_STAFF_AUG_EMAILS=
# CONTACT_LEGACY_MOD_EMAILS=
# CONTACT_MOBILE_DEV_EMAILS=
# CONTACT_CLOUD_DEVOPS_EMAILS=
# CONTACT_AI_ML_EMAILS=
# CONTACT_CUSTOM_SOFTWARE_EMAILS=
# CONTACT_TECHNICAL_CALL_EMAILS=

# ── reCAPTCHA (optional; if both unset, captcha is skipped) ──
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=         # 🏗️
RECAPTCHA_SECRET_KEY=                   # 🔒 captcha verification

# ── NOT needed for the website runtime (Sanity Studio CLI only) ──
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=
